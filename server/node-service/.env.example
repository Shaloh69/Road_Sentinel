# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# MySQL Database — self-hosted, local to whichever machine runs this service
# (irm-pc in production). Aiven was dropped entirely in Phase 0.5 (its
# hostname went NXDOMAIN and was not recovered) in favor of a local MySQL
# instance bound to localhost only — never expose this port publicly, not
# even through Tailscale. migrate.ts is the authoritative schema source and
# is idempotent (CREATE TABLE IF NOT EXISTS), so pointing this at a fresh,
# empty database and starting the server is enough to initialize it.
DB_HOST=localhost
DB_PORT=3306
DB_USER=roadsentinel
DB_PASSWORD=your-local-mysql-password
DB_NAME=roadsentinel
DB_SSL=false

# Storage: media (incident snapshots/recordings) is served by the AI service's
# local disk storage (server/ai-service, behind its Cloudflare Tunnel) — see
# src/config/supabase.ts and src/services/storage.service.ts. Supabase is not
# used; there is nothing to configure here for storage.

# Python AI Service
# Local dev:  http://localhost:8000
# Production: your Cloudflare Tunnel URL (see CLOUDFLARE_SELF_HOSTING.md)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30000

# WebSocket / CORS
# Socket.IO runs on the same port as Express (PORT above).
# Comma-separated list of allowed origins — enforced on both the REST API
# (cors middleware) and the Socket.IO handshake. No wildcard "*" anymore.
CORS_ORIGIN=http://localhost:3000

# Admin auth (Phase 0)
# JWT_SECRET: random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# ADMIN_PASSWORD: the password used to log into the /admin dashboard (POST /api/auth/login)
# PI_AGENT_TOKEN: shared secret raspi_scripts/pi_agent.py uses to authenticate to the /admin
#   Socket.IO namespace — same value must be set as PI_AGENT_TOKEN in each Pi's environment
JWT_SECRET=change-me-generate-a-random-64-char-hex-string
JWT_EXPIRES_IN=12h
ADMIN_PASSWORD=change-me
PI_AGENT_TOKEN=change-me-generate-a-random-shared-secret

# Critical-incident alert webhook (Phase 2, optional — unset = disabled)
# Generic JSON POST, compatible with Slack/Discord incoming webhooks, Zapier,
# IFTTT, n8n, or a custom endpoint — see src/services/alert.service.ts.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
# ALERT_WEBHOOK_MIN_SEVERITY=critical   # low | medium | high | critical

# Logging
LOG_LEVEL=info
# Combined log path (production only — console-only in development). The
# error-level log is written alongside it automatically, e.g. LOG_FILE=
# ./logs/app.log also produces ./logs/error.app.log.
LOG_FILE=./logs/app.log
