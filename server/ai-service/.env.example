# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Model Configuration
# Relative paths resolve against server/ai-service/ (this folder), regardless
# of the process's working directory — safe to commit as a relative path.
# Example pointing at the trained vehicle model:
#   TRAFFIC_MODEL_PATH=../../models/runs/vehicle/vehicle_yolo26n_20260203_032528/weights/best.pt
TRAFFIC_MODEL_PATH=./models/traffic.pt
INCIDENT_MODEL_PATH=./models/incident.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# Device Configuration (cuda, cpu, mps)
DEVICE=cuda
